<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home | GigaZen</title>

    <link rel="stylesheet" href="css/home.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">
    <link rel="icon" type="image/png" href="/img/logoNew2.ico">
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700&family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body>

    <nav class="navbar">
        <div class="nav-container">

            <div class="logo">
                <!-- <img src="/img/logoNew2.png" alt="GigaZen" height="10%" width="10%"> -->
            </div>

            <ul class="nav-links" id="navLinks">
                <li><a href="/">Hub</a></li>
                <li><a href="/payment">Plans</a></li>
                <li><a href="#contact-container">Connect</a></li>
                <li><a href="/about">About</a></li>
                
                

                <% if (!user) { %>
                    <a href="/login" class="loginbtn">Login</a>
                    <% } %>
            </ul>

            <div class="hamburger" onclick="toggleMenu()">
                <i class="fa-solid fa-bars"></i>
            </div>

        </div>
    </nav>

    <% if(user) { %>
        <span class="userhead">Welcome <%= user.name %></span>
        <a href="/logout" class="logoutbtn">Logout</a>
        <% } %>



            <% if(logout){ %>
                <script>
                    Swal.fire({
                        title: "Logged Out 👋",
                        text: "You have been logged out successfully!",
                        icon: "success",
                        timer: 2000,
                        showConfirmButton: false,
                        background: "#020617",
                        color: "#22c55e"
                    });
                </script>
                <% } %>

                    <% if(login){ %>
                        <script>
                            Swal.fire({
                                title: "Welcome 🎉",
                                text: "Login successful!",
                                icon: "success",
                                timer: 2000,
                                showConfirmButton: false,
                                background: "#020617",
                                color: "#22c55e"
                            });
                        </script>
                        <% } %>


                            <% if(feedback){ %>
                                <script>
                                    Swal.fire({
                                        icon: 'success',
                                        title: 'Submitted!',
                                        text: 'Your details were saved successfully.',
                                        showConfirmButton: false,
                                        timer: 2000
                                    });
                                </script>
                                <% } %>

                                    <section class="hero">
                                        <div class="hero-content">

                                            <p class="tag fade-up">PLAY ANY PC GAMES INSTANTLY</p>

                                            <h1 class="head fade-up">
                                                RENT PREMIUM GAMES FOR A FRACTION OF THE COST
                                            </h1>

                                            <p class="desc fade-up">
                                                Unlock a massive library of top PC titles. No high cost needed,
                                                no full purchase required. Start gaming now.
                                            </p>

                                            <a href="/payment" class="rentbtn">Rent Now</a>

                                        </div>
                                    </section>

                                    <section class="contact">
                                        <div id="contact-container">

                                            <h2>Contact Us</h2>

                                            <form action="/" method="post">
                                                <input type="text" name="name" placeholder="Player Name"
                                                    class="upperinput">
                                                <input type="text" name="email" placeholder="Player Email"
                                                    class="upperinput">
                                                <input type="text" name="suggestion" placeholder="Any Game Suggestion"
                                                    class="upperinput">

                                                <div class="form-btns">
                                                    <button type="reset" value="Reset" class="lowerinput">RESET
                                                        <button type="submit" value="Submit" class="lowerinput">SUBMIT
                                                </div>
                                            </form>

                                        </div>
                                    </section>

                                    <footer class="footer">
                                        <div class="footer-container">

                                            <div>
                                                <h2>GigaZen</h2>
                                                <p>Rent premium games at minimal cost.</p>
                                            </div>

                                            <div class="links">
                                                <div>
                                                    <h4>Services</h4>
                                                    <!-- <p>Features</p> -->
                                                    <a href="/payment">
                                                        <p>Pricing</p>
                                                    </a>
                                                </div>

                                                <div>
                                                    <h4>Resources</h4>
                                                    <a href="/privacy">
                                                        <p class="resource">Privacy Policy</p>
                                                    </a>
                                                    <a href="/refund">
                                                        <p class="resource">Refund Policy</p>
                                                    </a>
                                                    <a href="/terms">
                                                        <p class="resource">Terms and Conditions</p>
                                                    </a>
                                                </div>

                                                <div>
                                                    <h4>Contact</h4>
                                                    <p class="About">Arjun Shukla</p>
                                                    <p class="About">7607104099</p>
                                                    <p class="About">support@gigazen.in</p>
                                                </div>
                                            </div>

                                        </div>
                                    </footer>

                                    <script>

                                        const elements = document.querySelectorAll('.fade-up');

                                        const observer = new IntersectionObserver(entries => {
                                            entries.forEach(entry => {
                                                if (entry.isIntersecting) {
                                                    entry.target.classList.add('show');
                                                }
                                            });
                                        });

                                        elements.forEach(el => observer.observe(el));
                                        function toggleMenu() {
                                            document.getElementById("navLinks").classList.toggle("active");
                                        }
                                    </script>

</body>

</html>